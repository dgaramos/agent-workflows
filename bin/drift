#!/usr/bin/env bash
# bin/drift — detect stale core/ references in profile files
#
# Catalog discovery order (first match wins):
#   1. AGENT_WORKFLOWS_DIR environment variable
#   2. CWD self-detection (bin/check marker present in current directory)
#   3. Pointer file at ~/.local/share/dr-agents/catalog-path
#
# When no catalog is locatable: prints a warning naming all three discovery
# methods and exits 0 so consumer CI is never broken by a missing installation.
#
# When a profile references a core/ path that does not exist in the catalog:
# prints one violation line per missing path and exits 1.

set -euo pipefail

readonly pointer_file="${HOME}/.local/share/dr-agents/catalog-path"

# ---------------------------------------------------------------------------
# Locate the catalog root
# ---------------------------------------------------------------------------

locate_catalog() {
  # 1. Explicit env var override
  if [[ -n "${AGENT_WORKFLOWS_DIR:-}" && -d "${AGENT_WORKFLOWS_DIR}" ]]; then
    echo "${AGENT_WORKFLOWS_DIR}"
    return 0
  fi

  # 2. CWD self-detection: presence of bin/check is the catalog marker
  if [[ -f "$(pwd)/bin/check" ]]; then
    echo "$(pwd)"
    return 0
  fi

  # 3. Pointer file written by bin/install
  if [[ -f "${pointer_file}" ]]; then
    local catalog_from_pointer
    catalog_from_pointer="$(cat "${pointer_file}")"
    if [[ -d "${catalog_from_pointer}" ]]; then
      echo "${catalog_from_pointer}"
      return 0
    fi
  fi

  return 1
}

catalog=""
if ! catalog="$(locate_catalog)"; then
  echo "warning: no dr-agents catalog locatable;" \
       "set AGENT_WORKFLOWS_DIR, run from the catalog directory (bin/check marker)," \
       "or write the catalog path to ${pointer_file} (catalog-path pointer file)" >&2
  exit 0
fi

# ---------------------------------------------------------------------------
# Discover profiles
# ---------------------------------------------------------------------------

profile_files=()

# profiles/*.md (excluding .gitkeep)
while IFS= read -r -d '' f; do
  [[ "$(basename "$f")" == ".gitkeep" ]] && continue
  profile_files+=("$f")
done < <(find "${catalog}/profiles" -maxdepth 1 -name "*.md" -print0 2>/dev/null || true)

# .agent-review/*/PROFILE.md
while IFS= read -r -d '' f; do
  profile_files+=("$f")
done < <(find "${catalog}/.agent-review" -maxdepth 2 -name "PROFILE.md" -print0 2>/dev/null || true)

if [[ "${#profile_files[@]}" -eq 0 ]]; then
  echo "profile drift check: ok (0 profile(s) checked)"
  exit 0
fi

# ---------------------------------------------------------------------------
# Check each profile
# ---------------------------------------------------------------------------

violations=0
checked=0

for profile in "${profile_files[@]}"; do
  # Extract all core/... path tokens (e.g. core/foo/bar.md)
  while IFS= read -r ref; do
    target="${catalog}/${ref}"
    if [[ ! -e "${target}" ]]; then
      echo "drift: ${profile} references ${ref} (not found in ${catalog})" >&2
      violations=$((violations + 1))
    fi
  done < <(grep -oE 'core/[A-Za-z0-9._/-]+' "${profile}" | sort -u || true)
  checked=$((checked + 1))
done

if [[ "${violations}" -gt 0 ]]; then
  exit 1
fi

echo "profile drift check: ok (${checked} profile(s) checked)"
