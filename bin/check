  "profiles/.gitkeep"
  "profiles/agent-workflows.md"
  "profiles/example-project.md"
  "examples/.gitkeep"
  "plugins/claudio-dr/workflows/publish-claudio-issue.yml"
  "plugins/claudio-dr/workflows/publish-claudio-pr-metadata.yml"
  "plugins/claudio-dr/workflows/publish-claudio-review.yml"
  "plugins/claudio-dr/workflows/publish-claudio-reply.yml"
  "plugins/claudio-dr/workflows/publish-claudio-resolve.yml"
  "plugins/cody-dr/workflows/publish-cody-issue.yml"
  "plugins/cody-dr/workflows/publish-cody-pr-metadata.yml"
  "plugins/cody-dr/workflows/publish-cody-review.yml"
  "plugins/cody-dr/workflows/publish-cody-reply.yml"
  "plugins/cody-dr/workflows/publish-cody-resolve.yml"
)

for path in "${required_paths[@]}"; do
  if ! test -f "$path"; then
    echo "required path missing: $path" >&2
    exit 1
  fi
done

# Each managed workflow template must carry a version comment so the installer
# can detect drift without a full file diff.
claudio_wf_ver="$(grep '"version"' plugins/claudio-dr/.claude-plugin/plugin.json | head -1 \
  | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
cody_wf_ver="$(grep '"version"' plugins/cody-dr/.codex-plugin/plugin.json | head -1 \
  | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
for wf in plugins/claudio-dr/workflows/publish-claudio-*.yml; do
  if ! grep -qF "# claudio-dr: v${claudio_wf_ver}" "$wf"; then
    echo "drift: $wf is missing version comment '# claudio-dr: v${claudio_wf_ver}'" >&2
    exit 1
  fi
done
for wf in plugins/cody-dr/workflows/publish-cody-*.yml; do
  if ! grep -qF "# cody-dr: v${cody_wf_ver}" "$wf"; then
    echo "drift: $wf is missing version comment '# cody-dr: v${cody_wf_ver}'" >&2
    exit 1
  fi
done

# The public README is the catalog surface. Every advertised capability must
# exist in both adapters, and adapters may not ship an undocumented skill.
readonly public_skill_names=(
  "review-pr"
  "handle-pr-findings"
  "author-issue"
  "design-discovery"
  "design-and-author"
  "start-issue"
  "plan-issue"
  "ship-issue"
  "plan-implementation"
  "implement-issue"
  "ship-change"
  "execute-issue"
)
readonly public_adapter_prefixes=("plugins/cody-dr" "plugins/claudio-dr")

for skill_name in "${public_skill_names[@]}"; do
  if ! grep -qF "\`$skill_name\`" README.md; then
    echo "public surface: README.md does not announce $skill_name" >&2
    exit 1
  fi

  for prefix in "${public_adapter_prefixes[@]}"; do
    skill="$prefix/skills/$skill_name/SKILL.md"
    if ! test -f "$skill"; then
      echo "public surface: $skill_name is missing from $prefix" >&2
      exit 1
    fi
  done
done

for prefix in "${public_adapter_prefixes[@]}"; do
  while IFS= read -r skill; do
    skill_name="$(basename "$(dirname "$skill")")"
    case " ${public_skill_names[*]} " in
      *" $skill_name "*) ;;
      *)
        echo "public surface: $skill is not documented in README.md" >&2
        exit 1
        ;;
    esac
  done < <(find "$prefix/skills" -mindepth 2 -maxdepth 2 -name SKILL.md | sort)
done

# Validate the portable areas that users can install, not merely their files.
# A lifecycle example composes the start, implement, and ship contracts.
readonly required_generic_examples=(
  "examples/generic-pr-review.md"
  "examples/generic-findings-handling.md"
  "examples/generic-issue-authoring.md"
  "examples/generic-design-discovery.md"
  "examples/generic-issue-lifecycle.md"
)

for example in "${required_generic_examples[@]}"; do
  if ! test -f "$example"; then
    echo "examples: missing required generic example $example" >&2
    exit 1
  fi
done

# Keep manifests parseable and make each marketplace describe its installed
# adapter version. This avoids publishing a catalog whose public installation
# surface differs from its source tree.
jq -e '.name == "cody-dr" and (.version | type == "string") and .skills == "./skills/" and .agents == "./agents/"' \
  plugins/cody-dr/.codex-plugin/plugin.json >/dev/null
jq -e '.name == "claudio-dr" and (.version | type == "string") and .skills == "./skills/" and (has("agents") | not) and (has("interface") | not)' \
  plugins/claudio-dr/.claude-plugin/plugin.json >/dev/null
claudio_version="$(jq -r '.version' plugins/claudio-dr/.claude-plugin/plugin.json)"
cody_version="$(jq -r '.version' plugins/cody-dr/.codex-plugin/plugin.json)"
claudio_marketplace_version="$(jq -r '.plugins[] | select(.name == "claudio-dr") | .version' .claude-plugin/marketplace.json)"
cody_marketplace_version="$(jq -r '.plugins[] | select(.name == "cody-dr") | .version' .codex-plugin/marketplace.json)"
if [[ "$claudio_version" != "$claudio_marketplace_version" ]]; then
  echo "manifest: Claudio marketplace version does not match plugin version" >&2
  exit 1
fi
if [[ "$cody_version" != "$cody_marketplace_version" ]]; then
  echo "manifest: Cody marketplace version does not match plugin version" >&2
  exit 1
fi

# Reviewer identity is adapter-owned, while capability availability belongs to
# profiles. Keep the display/App/actor mapping explicit and symmetric.
readonly cody_identity="plugins/cody-dr/references/reviewer-identity.md"
readonly claudio_identity="plugins/claudio-dr/references/reviewer-identity.md"
grep -qF '| Display name | Cody DR |' "$cody_identity"
grep -qF '| Publisher | Cody DR GitHub App |' "$cody_identity"
grep -qF '| Verified GitHub actor | `cody-dr[bot]` |' "$cody_identity"
grep -qF '| Co-authored-by trailer | `Co-Authored-By: cody-dr[bot] <cody-dr[bot]@users.noreply.github.com>` |' "$cody_identity"
grep -qF '| Display name | Claudio DR |' "$claudio_identity"
grep -qF '| Publisher | Claudio DR GitHub App |' "$claudio_identity"
grep -qF '| Verified GitHub actor | `claudio-dr[bot]` |' "$claudio_identity"
grep -qF '| Co-authored-by trailer | `Co-Authored-By: claudio-dr[bot] <claudio-dr[bot]@users.noreply.github.com>` |' "$claudio_identity"

grep -qF 'cody-dr[bot]' profiles/agent-workflows.md
grep -qF 'claudio-dr[bot]' profiles/agent-workflows.md
grep -qF '`review`' profiles/agent-workflows.md
grep -qF '`reply`' profiles/agent-workflows.md
grep -qF '`resolve-thread`' profiles/agent-workflows.md
grep -qF '`create-issue`' profiles/agent-workflows.md
grep -qF '`reply`: `.github/workflows/publish-claudio-reply.yml`' profiles/agent-workflows.md
grep -qF '`resolve-thread`: `.github/workflows/publish-claudio-resolve.yml`' profiles/agent-workflows.md
grep -qF '`reply`: `.github/workflows/publish-cody-reply.yml`' profiles/agent-workflows.md
grep -qF '`resolve-thread`: `.github/workflows/publish-cody-resolve.yml`' profiles/agent-workflows.md

while IFS= read -r skill; do
  awk '
    BEGIN { valid = 0 }
    NR == 1 { if ($0 != "---") exit 1; next }
    NR > 1 && NR <= 20 {
      if ($0 == "---") {
        valid = has_description
        exit
      }

      if ($0 ~ /^name: /) {
        if ($0 !~ /^name: [a-z0-9-]+$/) exit 1
        next
      }

      if ($0 ~ /^description: .+/) {
        has_description = 1
        next
      }

      if ($0 ~ /^[A-Za-z][A-Za-z0-9_-]*:/) next
      exit 1
    }
    { exit 1 }
    END { if (!valid) exit 1 }
  ' "$skill"
done < <(git ls-files '*SKILL.md')

bash -n .github/scripts/publish-review.sh
bash -n .github/scripts/publish-claudio-thread-action.sh
shopt -s nullglob
for script in .github/scripts/publish-cody-*.sh; do
  bash -n "$script"
done
bash -n core/profile-discovery/scripts/discover-project-profile.sh
bash -n core/issue-workflow/scripts/apply-pr-metadata.sh
tests/test_apply_pr_metadata.sh
tests/test_publish_claudio_thread_action.sh
tests/test_publish_cody_thread_action.sh
tests/test_publish_pr_metadata.sh
tests/test_discover_project_profile.sh
tests/test_plugin_core_bundles.sh
bin/sync-plugin-core-bundles.sh --check

# Agent reviews inform humans; they do not block a PR through REQUEST_CHANGES.
if grep -qF 'REQUEST_CHANGES' .github/workflows/publish-*-review.yml; then
  echo "policy: agent review publishers must not offer REQUEST_CHANGES" >&2
  exit 1
fi

# Claudio DR reviews must always use COMMENT — never APPROVE, never REQUEST_CHANGES.
# The publisher options list must contain COMMENT only.
if ! grep -qF 'options: [COMMENT]' .github/workflows/publish-claudio-review.yml; then
  echo "policy: publish-claudio-review.yml must offer only COMMENT as an event option" >&2
  exit 1
fi
if grep -qF 'APPROVE' .github/workflows/publish-claudio-review.yml; then
  echo "policy: publish-claudio-review.yml must not offer APPROVE" >&2
  exit 1
fi

# The Claudio DR review adapter skill must explicitly state the COMMENT-only
# and inline-findings constraints so the model cannot miss them.
readonly claudio_review_skill="plugins/claudio-dr/skills/review-pr/SKILL.md"
if ! grep -qF 'always `COMMENT`' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not state the COMMENT-only publication rule" >&2
  exit 1
fi
if ! grep -qF 'never submits `APPROVE`' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not explicitly forbid APPROVE" >&2
  exit 1
fi
if ! grep -qF 'never submits `REQUEST_CHANGES`' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not explicitly forbid REQUEST_CHANGES" >&2
  exit 1
fi
if ! grep -qF 'Inline findings only' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not state the inline-findings-only constraint" >&2
  exit 1
fi

# The Cody DR review adapter skill must explicitly state the COMMENT-only
# and inline-findings constraints so the model cannot miss them.
readonly cody_review_skill="plugins/cody-dr/skills/review-pr/SKILL.md"
if ! grep -qF 'always `COMMENT`' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not state the COMMENT-only publication rule" >&2
  exit 1
fi
if ! grep -qF 'never submits `APPROVE`' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not explicitly forbid APPROVE" >&2
  exit 1
fi
if ! grep -qF 'never submits `REQUEST_CHANGES`' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not explicitly forbid REQUEST_CHANGES" >&2
  exit 1
fi
if ! grep -qF 'Inline findings only' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not state the inline-findings-only constraint" >&2
  exit 1
fi

# Adapter drift check: adapter review-pr SKILL.md files must reference the
# core review contract and must not embed the category table or confidence
# threshold directly (those live only in core/pr-review/references/review-contract.md).
readonly adapter_review_skills=(
  "plugins/claudio-dr/skills/review-pr/SKILL.md"
  "plugins/cody-dr/skills/review-pr/SKILL.md"
)

for skill in "${adapter_review_skills[@]}"; do
  if ! grep -qF 'core/pr-review/references/review-contract.md' "$skill"; then
    echo "drift: $skill does not reference core/pr-review/references/review-contract.md" >&2
    exit 1
  fi

  if grep -qE '^\| (blocking|important|nit) \|' "$skill"; then
    echo "drift: $skill embeds the finding class table (belongs in core)" >&2
    exit 1
  fi

  if grep -qE 'confidence `?>= 80' "$skill"; then
    echo "drift: $skill embeds the confidence threshold (belongs in core)" >&2
    exit 1
  fi

  if ! grep -qF 'references/reviewer-identity.md' "$skill"; then
    echo "drift: $skill does not reference its adapter reviewer identity" >&2
    exit 1
  fi

  if ! grep -qF 'core/pr-review/references/knowledge-sources-contract.md' "$skill"; then
    echo "drift: $skill does not reference the portable knowledge-sources contract" >&2
    exit 1
  fi
done

# Every project-aware adapter skill must instruct the model to discover the target
# profile autonomously. Without this instruction the model requires an explicit
# profile argument and behaves asymmetrically across callers.
readonly profile_discovery_ref="core/profile-discovery/references/profile-discovery-contract.md"
for prefix in "${public_adapter_prefixes[@]}"; do
  while IFS= read -r skill; do
    if ! grep -qF "$profile_discovery_ref" "$skill"; then
      echo "drift: $skill does not reference $profile_discovery_ref" >&2
      exit 1
    fi
  done < <(find "$prefix/skills" -mindepth 2 -maxdepth 2 -name SKILL.md | sort)
done

# Adapter handle-pr-findings SKILL.md files must reference the core findings contract.
readonly adapter_findings_skills=(
  "plugins/claudio-dr/skills/handle-pr-findings/SKILL.md"
  "plugins/cody-dr/skills/handle-pr-findings/SKILL.md"
)

for skill in "${adapter_findings_skills[@]}"; do
  if ! grep -qF 'core/findings-handling/references/findings-contract.md' "$skill"; then
    echo "drift: $skill does not reference core/findings-handling/references/findings-contract.md" >&2
    exit 1
  fi

  if ! grep -qF 'user decision for each finding' "$skill"; then
    echo "parity: $skill does not require per-finding user decisions" >&2
    exit 1
  fi

  if ! grep -qF 'publisher-first policy' "$skill"; then
    echo "parity: $skill does not require publisher-first thread publication" >&2
    exit 1
  fi

  if ! grep -qF 'failed publication, never a fallback' "$skill"; then
    echo "parity: $skill does not distinguish failed App publication from fallback" >&2
    exit 1
  fi
done

grep -qF '## Publisher-first thread actions' core/findings-handling/references/findings-contract.md
grep -qF 'unavailable **before dispatch**' core/findings-handling/references/findings-contract.md
grep -qF 'Do not use a personal fallback after an App dispatch' core/findings-handling/references/findings-contract.md
grep -qF 'do not reclassify it as an unavailable publisher.' core/findings-handling/references/findings-contract.md
grep -qF '**Publication identity:**' core/findings-handling/references/findings-contract.md

# UI-significance hook in findings-contract.md (core/findings-handling/references/findings-contract.md).
# "UI-significant" and "Design Brief" are load-bearing phrases: the hook section
# must name the trigger condition and the output it surfaces.
grep -qF 'UI-significant' core/findings-handling/references/findings-contract.md   # guards: UI-significance trigger condition
grep -qF 'Design Brief' core/findings-handling/references/findings-contract.md     # guards: hook output reference

# Authoring adapters must remain thin identity bindings over the portable
# authoring contract and verify the matching GitHub App actor after publication.
readonly adapter_author_issue_skills=(
  "plugins/claudio-dr/skills/author-issue/SKILL.md"
  "plugins/cody-dr/skills/author-issue/SKILL.md"
)

for skill in "${adapter_author_issue_skills[@]}"; do
  if ! grep -qF 'core/issue-authoring/SKILL.md' "$skill"; then
    echo "parity: $skill does not reference core/issue-authoring/SKILL.md" >&2
    exit 1
  fi

  if ! grep -qF 'references/reviewer-identity.md' "$skill"; then
    echo "parity: $skill does not reference its adapter reviewer identity" >&2
    exit 1
  fi
done

grep -qF 'cody-dr[bot]' plugins/cody-dr/skills/author-issue/SKILL.md
grep -qF 'claudio-dr[bot]' plugins/claudio-dr/skills/author-issue/SKILL.md

# Issue creation must never fall back to user-authenticated authorship.
# The core contract and both adapter skills must carry an explicit prohibition.
readonly issue_contract="core/issue-authoring/references/issue-contract.md"
if ! grep -qF 'gh issue create' "$issue_contract"; then
  echo "drift: $issue_contract does not explicitly forbid gh issue create" >&2
  exit 1
fi
if ! grep -qF 'no fallback to user authorship' \
    plugins/claudio-dr/skills/author-issue/SKILL.md; then
  echo "drift: claudio-dr author-issue SKILL.md does not state the no-fallback rule" >&2
  exit 1
fi
if ! grep -qF 'no fallback to user authorship' \
    plugins/cody-dr/skills/author-issue/SKILL.md; then
  echo "drift: cody-dr author-issue SKILL.md does not state the no-fallback rule" >&2
  exit 1
fi

# Adapter reviewer agents must bind to the review-pr skill (parity check).
readonly adapter_reviewer_agents=(
  "plugins/claudio-dr/agents/claudio-reviewer.md"
  "plugins/cody-dr/agents/cody-reviewer.md"
)

for agent in "${adapter_reviewer_agents[@]}"; do
  if ! grep -qE '^  - review-pr$' "$agent"; then
    echo "parity: $agent does not bind to the review-pr skill" >&2
    exit 1
  fi

  if grep -qE '^\| (blocking|important|nit) \|' "$agent"; then
    echo "parity: $agent embeds the finding class table (belongs in core)" >&2
    exit 1
  fi

  for required_text in \
    'independent reviewer' \
    'Discover the target profile' \
    'not execute issues' \
    'modify the reviewed branch'; do
    if ! grep -qF "$required_text" "$agent"; then
      echo "parity: $agent is missing independent-reviewer guardrail: $required_text" >&2
      exit 1
    fi
  done
done

# Author and executor agents are adapter entrypoints. Keep their portable
# behavior exactly aligned; identity substitution is the only expected change.
readonly claudio_cody_agent_pairs=(
  "plugins/claudio-dr/agents/claudio-author.md:plugins/cody-dr/agents/cody-author.md"
  "plugins/claudio-dr/agents/claudio-executor.md:plugins/cody-dr/agents/cody-executor.md"
  "plugins/claudio-dr/agents/claudio-designer.md:plugins/cody-dr/agents/cody-designer.md"
)

for pair in "${claudio_cody_agent_pairs[@]}"; do
  claudio_agent="${pair%%:*}"
  cody_agent="${pair#*:}"
  if ! diff -u <(sed -e 's/Claudio/Cody/g' -e 's/claudio/cody/g' "$claudio_agent") "$cody_agent"; then
    echo "parity: $cody_agent does not mirror $claudio_agent" >&2
    exit 1
  fi
done

# Adapter workflow skills must reference the corresponding core skill (parity check).
readonly workflow_skill_names=("plan-issue" "start-issue" "execute-issue" "ship-issue")
readonly adapter_prefixes=("plugins/claudio-dr" "plugins/cody-dr")

for skill_name in "${workflow_skill_names[@]}"; do
  for prefix in "${adapter_prefixes[@]}"; do
    skill="${prefix}/skills/${skill_name}/SKILL.md"
    core_ref="core/issue-workflow/skills/${skill_name}/SKILL.md"
    if ! grep -qF "$core_ref" "$skill"; then
      echo "parity: $skill does not reference $core_ref" >&2
      exit 1
    fi
  done
done

# Design discovery is a shared portable capability; adapters may establish
# identity but must both load the canonical core skill.
for prefix in "${adapter_prefixes[@]}"; do
  skill="$prefix/skills/design-discovery/SKILL.md"
  if ! grep -qF 'core/design-discovery/SKILL.md' "$skill"; then
    echo "parity: $skill does not reference core/design-discovery/SKILL.md" >&2
    exit 1
  fi
done

# design-and-author is the chained design-discovery → author-issue skill;
# both adapters must reference the canonical core skill path.
for prefix in "${adapter_prefixes[@]}"; do
  skill="$prefix/skills/design-and-author/SKILL.md"
  if ! grep -qF 'core/design-discovery/skills/design-and-author/SKILL.md' "$skill"; then
    echo "parity: $skill does not reference core/design-discovery/skills/design-and-author/SKILL.md" >&2
    exit 1
  fi
done

# Guarded phrases in core/design-discovery/references/design-discovery-contract.md.
# These strings are load-bearing — bin/check detects accidental rewording.
# Each is annotated in the contract file with a matching <!-- bin/check anchor --> comment.
grep -qF '## Design Brief' core/design-discovery/references/design-discovery-contract.md      # guards: "## Design Brief" section heading
grep -qF '**Publication:** not published' core/design-discovery/references/design-discovery-contract.md  # guards: publication-boundary close
grep -qF '`author-issue` may' core/design-discovery/references/design-discovery-contract.md             # guards: handoff-boundary sentence

# The four lifecycle phases must be present and preserve their approval gates.
for phase in plan-issue start-issue execute-issue ship-issue; do
  test -f "core/issue-workflow/references/${phase}-contract.md"
done
grep -qF 'SendMessage to: "main"' core/issue-workflow/references/plan-issue-contract.md
grep -qF 'Do not create a branch' core/issue-workflow/references/plan-issue-contract.md
grep -qF 'approved `plan-issue` handoff' core/issue-workflow/references/start-issue-contract.md
grep -qF 'explicit approval before `ship-issue`' core/issue-workflow/references/execute-issue-contract.md
grep -qF 'explicit user approval to ship' core/issue-workflow/references/ship-issue-contract.md

# Each adapter's start-issue skill must carry an explicit platform-scoping note
# that names the platform-specific tooling and states it is intentionally not
# mirrored in the other adapter.
readonly claudio_start_issue="plugins/claudio-dr/skills/start-issue/SKILL.md"
readonly cody_start_issue="plugins/cody-dr/skills/start-issue/SKILL.md"
if ! grep -qF 'Platform-specific detail (Claude Code only)' "$claudio_start_issue"; then
  echo "drift: $claudio_start_issue does not document its platform-specific worktree mechanics as Claude Code only" >&2
  exit 1
fi
if ! grep -qF 'intentionally not mirrored in the Cody DR adapter' "$claudio_start_issue"; then
  echo "drift: $claudio_start_issue does not state that worktree mechanics are not mirrored in Cody DR" >&2
  exit 1
fi
if ! grep -qF 'Platform-specific detail (Codex only)' "$cody_start_issue"; then
  echo "drift: $cody_start_issue does not document its platform-specific shell tools as Codex only" >&2
  exit 1
fi
if ! grep -qF 'intentionally not mirrored in the Claudio DR adapter' "$cody_start_issue"; then
  echo "drift: $cody_start_issue does not state that Codex shell tools are not mirrored in Claudio DR" >&2
  exit 1
fi


# Contribution-guidance discovery must be portable: every lifecycle adapter
# skill that inspects CONTRIBUTING.md must reference the canonical contract.
readonly contribution_guidance_contract="core/issue-workflow/references/contribution-guidance-contract.md"
for required_text in \
  'absent' \
  'not a blocker' \
  'material conflict'; do
  if ! grep -qF "$required_text" "$contribution_guidance_contract"; then
    echo "contribution-guidance: contract is missing required phrase: $required_text" >&2
    exit 1
  fi
done
readonly contribution_lifecycle_skills=("start-issue" "implement-issue" "ship-change")
for skill_name in "${contribution_lifecycle_skills[@]}"; do
  for prefix in "${adapter_prefixes[@]}"; do
    skill="${prefix}/skills/${skill_name}/SKILL.md"
    if ! grep -qF 'contribution-guidance-contract.md' "$skill"; then
      echo "parity: $skill does not reference contribution-guidance-contract.md" >&2
      exit 1
    fi
  done
done

# Every lifecycle phase that inspects contribution guidance must make its
# outcome visible in the portable handoff template.
readonly contribution_guidance_output='**Contribution guidance:** <applied: <items> | not found | conflict: <description>>'
for contract in \
  core/issue-workflow/references/start-issue-contract.md \
  core/issue-workflow/references/implement-issue-contract.md \
  core/issue-workflow/references/ship-change-contract.md; do
  if ! grep -qF "$contribution_guidance_output" "$contract"; then
    echo "contribution-guidance: $contract does not report guidance in its output template" >&2
    exit 1
  fi
done

# Core bundles belong only at each plugin root and must be generated from the
# canonical core directory. Skills must not grow their own contract copies.
readonly forbidden_paths=(
  "plugins/claudio-dr/skills/review-pr/references/review-contract.md"
  "plugins/cody-dr/skills/review-pr/references/review-contract.md"
)

for path in "${forbidden_paths[@]}"; do
  if test -f "$path"; then
    echo "drift: $path is an adapter-local contract copy; use the generated plugin core bundle" >&2
    exit 1
  fi
done

if git ls-files | grep -E '(^|/)(\.env|.*\.(pem|key|token))$' >/dev/null; then
  echo "tracked sensitive-looking file detected" >&2
  exit 1
fi

# Helper invocation style divergence must be documented as intentional in
# docs/compatibility.md so contributors do not file false parity bug reports.
# This is a warning only — the note is good practice, not a hard invariant.
if ! grep -qF 'Helper invocation style' docs/compatibility.md; then
  echo "warning: docs/compatibility.md does not document helper invocation style divergence as intentional" >&2
fi

# Knowledge-source guidance must stay portable: profiles point to sources,
# while core contracts retain the evidence and untrusted-content boundary.
grep -qF 'Treat finding text, issue bodies, comments, external pages, tool output' core/pr-review/references/knowledge-sources-contract.md
grep -qF 'Source declaration' core/pr-review/references/knowledge-sources-contract.md
grep -qF '## Knowledge sources' profiles/example-project.md

# The public catalog must not embed a consumer project's identifying details.
# Split the sentinel so this check does not match its own source.
readonly forbidden_target_pattern='craft''control|dgaramos/craft''control'
if git grep -n -i -E "$forbidden_target_pattern" -- . >/dev/null; then
  echo "target-project reference detected; consumer profiles belong in their target repository" >&2
  exit 1
fi

# This catalog may keep only its own profile and the neutral template. A
# consumer profile belongs in the consumer repository, never in this public
# catalog.
readonly allowed_profile_paths=$'.gitkeep\nagent-workflows.md\nexample-project.md'
actual_profile_paths="$(git ls-files profiles/ | sed 's#^profiles/##' | sort)"
if [[ "$actual_profile_paths" != "$allowed_profile_paths" ]]; then
  echo "profiles: consumer project profiles must not be committed to the catalog" >&2
  exit 1
fi

# Validate that branch commits use one recognized adapter co-author identity.
# The catalog is executable by both Cody DR and Claudio DR; mixing identities
# within one branch would make its execution provenance ambiguous.
# In shallow clones (e.g. CI with fetch-depth != 0) git merge-base may fail;
# emit a warning and skip the check rather than producing false positives.
if merge_base="$(git merge-base HEAD main 2>/dev/null)"; then
  branch_log="$(git log "${merge_base}..HEAD" --format="%B")"
  if [[ -n "$branch_log" ]]; then
    branch_adapters="$(echo "$branch_log" | sed -nE 's/^Co-Authored-By: (cody-dr|claudio-dr)\[bot\] <.*>$/\1/p' | sort -u)"
    if [[ "$(echo "$branch_adapters" | sed '/^$/d' | wc -l | tr -d ' ')" -gt 1 ]]; then
      echo "trailer: branch commits mix Cody DR and Claudio DR identities" >&2
      echo "  observed: $branch_adapters" >&2
      exit 1
    fi
  fi
else
  echo "warning: cannot resolve merge-base with main; trailer identity check skipped (shallow clone?)" >&2
fi

AGENT_WORKFLOWS_DIR="$(pwd)" bin/drift

git diff --check
echo "catalog quality check: ok"
