#!/usr/bin/env bash
set -euo pipefail

readonly required_paths=(
  "README.md"
  "AGENTS.md"
  "CONTRIBUTING.md"
  "SECURITY.md"
  "docs/architecture.md"
  "docs/development.md"
  "docs/compatibility.md"
  ".github/workflows/publish-cody-issue.yml"
  ".github/workflows/publish-claudio-issue.yml"
  ".github/workflows/publish-cody-review.yml"
  ".github/workflows/publish-claudio-review.yml"
  ".github/workflows/publish-claudio-reply.yml"
  ".github/workflows/publish-claudio-resolve.yml"
  ".github/scripts/publish-review.sh"
  ".github/scripts/publish-claudio-thread-action.sh"
  "core/pr-review/SKILL.md"
  "core/pr-review/references/review-contract.md"
  "core/pr-review/references/reporting.md"
  "core/pr-review/references/profile-contract.md"
  "core/pr-review/references/reviewer-identity-contract.md"
  "core/pr-review/references/knowledge-sources-contract.md"
  "core/pr-review/agents/openai.yaml"
  "core/profile-discovery/references/profile-discovery-contract.md"
  "core/profile-discovery/scripts/discover-project-profile.sh"
  "core/issue-authoring/SKILL.md"
  "core/issue-authoring/references/issue-contract.md"
  "core/findings-handling/SKILL.md"
  "core/findings-handling/references/findings-contract.md"
  "core/issue-workflow/references/workflow-contract.md"
  "core/issue-workflow/references/start-issue-contract.md"
  "core/issue-workflow/references/implement-issue-contract.md"
  "core/issue-workflow/references/ship-change-contract.md"
  "core/issue-workflow/scripts/apply-pr-metadata.sh"
  "core/issue-workflow/references/execute-issue-contract.md"
  "core/issue-workflow/skills/start-issue/SKILL.md"
  "core/issue-workflow/skills/implement-issue/SKILL.md"
  "core/issue-workflow/skills/ship-change/SKILL.md"
  "core/issue-workflow/skills/execute-issue/SKILL.md"
  "examples/generic-pr-review.md"
  "examples/generic-profile-discovery.md"
  "examples/generic-issue-authoring.md"
  "examples/generic-findings-handling.md"
  "examples/generic-pr-shipping.md"
  "plugins/cody-dr/.codex-plugin/plugin.json"
  "plugins/cody-dr/skills/review-pr/SKILL.md"
  "plugins/cody-dr/skills/author-issue/SKILL.md"
  "plugins/cody-dr/skills/handle-pr-findings/SKILL.md"
  "plugins/cody-dr/skills/start-issue/SKILL.md"
  "plugins/cody-dr/skills/implement-issue/SKILL.md"
  "plugins/cody-dr/skills/ship-change/SKILL.md"
  "plugins/cody-dr/skills/execute-issue/SKILL.md"
  "plugins/cody-dr/agents/cody-reviewer.md"
  "plugins/cody-dr/agents/cody-workflow.md"
  "plugins/cody-dr/agents/cody-findings.md"
  "plugins/cody-dr/agents/cody-helper.md"
  "plugins/cody-dr/references/reviewer-identity.md"
  "docs/cody-dr.md"
  ".claude-plugin/marketplace.json"
  "plugins/claudio-dr/.claude-plugin/plugin.json"
  "plugins/claudio-dr/skills/review-pr/SKILL.md"
  "plugins/claudio-dr/skills/author-issue/SKILL.md"
  "plugins/claudio-dr/skills/handle-pr-findings/SKILL.md"
  "plugins/claudio-dr/skills/start-issue/SKILL.md"
  "plugins/claudio-dr/skills/implement-issue/SKILL.md"
  "plugins/claudio-dr/skills/ship-change/SKILL.md"
  "plugins/claudio-dr/skills/execute-issue/SKILL.md"
  "plugins/claudio-dr/agents/claudio-reviewer.md"
  "plugins/claudio-dr/agents/claudio-workflow.md"
  "plugins/claudio-dr/agents/claudio-findings.md"
  "plugins/claudio-dr/agents/claudio-helper.md"
  "plugins/claudio-dr/references/reviewer-identity.md"
  "docs/claudio-dr.md"
  "core/.gitkeep"
  "plugins/codex/.gitkeep"
  "plugins/claude/.gitkeep"
  "profiles/.gitkeep"
  "profiles/agent-workflows.md"
  "profiles/example-project.md"
  "examples/.gitkeep"
)

for path in "${required_paths[@]}"; do
  test -f "$path"
done

# Reviewer identity is adapter-owned, while capability availability belongs to
# profiles. Keep the display/App/actor mapping explicit and symmetric.
readonly cody_identity="plugins/cody-dr/references/reviewer-identity.md"
readonly claudio_identity="plugins/claudio-dr/references/reviewer-identity.md"
grep -qF '| Display name | Cody DR |' "$cody_identity"
grep -qF '| Publisher | Cody DR GitHub App |' "$cody_identity"
grep -qF '| Verified GitHub actor | `cody-dr[bot]` |' "$cody_identity"
grep -qF '| Display name | Claudio DR |' "$claudio_identity"
grep -qF '| Publisher | Claudio DR GitHub App |' "$claudio_identity"
grep -qF '| Verified GitHub actor | `claudio-dr[bot]` |' "$claudio_identity"

grep -qF 'cody-dr[bot]' profiles/agent-workflows.md
grep -qF 'claudio-dr[bot]' profiles/agent-workflows.md
grep -qF '`review`' profiles/agent-workflows.md
grep -qF '`reply`' profiles/agent-workflows.md
grep -qF '`resolve-thread`' profiles/agent-workflows.md
grep -qF '`create-issue`' profiles/agent-workflows.md
grep -qF '`reply`: `.github/workflows/publish-claudio-reply.yml`' profiles/agent-workflows.md
grep -qF '`resolve-thread`: `.github/workflows/publish-claudio-resolve.yml`' profiles/agent-workflows.md

while IFS= read -r skill; do
  awk '
    BEGIN { valid = 0 }
    NR == 1 { if ($0 != "---") exit 1; next }
    NR > 1 && NR <= 20 {
      if ($0 == "---") {
        valid = has_description
        exit
      }

      if ($0 ~ /^name: /) {
        if ($0 !~ /^name: [a-z0-9-]+$/) exit 1
        next
      }

      if ($0 ~ /^description: .+/) {
        has_description = 1
        next
      }

      if ($0 ~ /^[A-Za-z][A-Za-z0-9_-]*:/) next
      exit 1
    }
    { exit 1 }
    END { if (!valid) exit 1 }
  ' "$skill"
done < <(git ls-files '*SKILL.md')

bash -n .github/scripts/publish-review.sh
bash -n .github/scripts/publish-claudio-thread-action.sh
bash -n core/profile-discovery/scripts/discover-project-profile.sh
bash -n core/issue-workflow/scripts/apply-pr-metadata.sh
tests/test_apply_pr_metadata.sh
tests/test_publish_claudio_thread_action.sh
tests/test_discover_project_profile.sh

# Agent reviews inform humans; they do not block a PR through REQUEST_CHANGES.
if grep -qF 'REQUEST_CHANGES' .github/workflows/publish-*-review.yml; then
  echo "policy: agent review publishers must not offer REQUEST_CHANGES" >&2
  exit 1
fi

# Adapter drift check: adapter review-pr SKILL.md files must reference the
# core review contract and must not embed the category table or confidence
# threshold directly (those live only in core/pr-review/references/review-contract.md).
readonly adapter_review_skills=(
  "plugins/claudio-dr/skills/review-pr/SKILL.md"
  "plugins/cody-dr/skills/review-pr/SKILL.md"
)

for skill in "${adapter_review_skills[@]}"; do
  if ! grep -qF 'core/pr-review/references/review-contract.md' "$skill"; then
    echo "drift: $skill does not reference core/pr-review/references/review-contract.md" >&2
    exit 1
  fi

  if grep -qE '^\| (blocking|important|nit) \|' "$skill"; then
    echo "drift: $skill embeds the finding class table (belongs in core)" >&2
    exit 1
  fi

  if grep -qE 'confidence `?>= 80' "$skill"; then
    echo "drift: $skill embeds the confidence threshold (belongs in core)" >&2
    exit 1
  fi

  if ! grep -qF 'references/reviewer-identity.md' "$skill"; then
    echo "drift: $skill does not reference its adapter reviewer identity" >&2
    exit 1
  fi

  if ! grep -qF 'core/pr-review/references/knowledge-sources-contract.md' "$skill"; then
    echo "drift: $skill does not reference the portable knowledge-sources contract" >&2
    exit 1
  fi
done

# Adapter handle-pr-findings SKILL.md files must reference the core findings contract.
readonly adapter_findings_skills=(
  "plugins/claudio-dr/skills/handle-pr-findings/SKILL.md"
  "plugins/cody-dr/skills/handle-pr-findings/SKILL.md"
)

for skill in "${adapter_findings_skills[@]}"; do
  if ! grep -qF 'core/findings-handling/references/findings-contract.md' "$skill"; then
    echo "drift: $skill does not reference core/findings-handling/references/findings-contract.md" >&2
    exit 1
  fi

  if ! grep -qF 'user decision for each finding' "$skill"; then
    echo "parity: $skill does not require per-finding user decisions" >&2
    exit 1
  fi
done

# Authoring adapters must remain thin identity bindings over the portable
# authoring contract and verify the matching GitHub App actor after publication.
readonly adapter_author_issue_skills=(
  "plugins/claudio-dr/skills/author-issue/SKILL.md"
  "plugins/cody-dr/skills/author-issue/SKILL.md"
)

for skill in "${adapter_author_issue_skills[@]}"; do
  if ! grep -qF 'core/issue-authoring/SKILL.md' "$skill"; then
    echo "parity: $skill does not reference core/issue-authoring/SKILL.md" >&2
    exit 1
  fi

  if ! grep -qF 'references/reviewer-identity.md' "$skill"; then
    echo "parity: $skill does not reference its adapter reviewer identity" >&2
    exit 1
  fi
done

grep -qF 'cody-dr[bot]' plugins/cody-dr/skills/author-issue/SKILL.md
grep -qF 'claudio-dr[bot]' plugins/claudio-dr/skills/author-issue/SKILL.md

# Adapter reviewer agents must bind to the review-pr skill (parity check).
readonly adapter_reviewer_agents=(
  "plugins/claudio-dr/agents/claudio-reviewer.md"
  "plugins/cody-dr/agents/cody-reviewer.md"
)

for agent in "${adapter_reviewer_agents[@]}"; do
  if ! grep -qE '^  - review-pr$' "$agent"; then
    echo "parity: $agent does not bind to the review-pr skill" >&2
    exit 1
  fi

  if grep -qE '^\| (blocking|important|nit) \|' "$agent"; then
    echo "parity: $agent embeds the finding class table (belongs in core)" >&2
    exit 1
  fi
done

# Adapter workflow skills must reference the corresponding core skill (parity check).
readonly workflow_skill_names=("start-issue" "implement-issue" "ship-change" "execute-issue")
readonly adapter_prefixes=("plugins/claudio-dr" "plugins/cody-dr")

for skill_name in "${workflow_skill_names[@]}"; do
  for prefix in "${adapter_prefixes[@]}"; do
    skill="${prefix}/skills/${skill_name}/SKILL.md"
    core_ref="core/issue-workflow/skills/${skill_name}/SKILL.md"
    if ! grep -qF "$core_ref" "$skill"; then
      echo "parity: $skill does not reference $core_ref" >&2
      exit 1
    fi
  done
done

grep -qF 'Metadata verified:' core/issue-workflow/references/ship-change-contract.md
grep -qF 'apply-pr-metadata.sh' core/issue-workflow/references/ship-change-contract.md
grep -qF 'apply-pr-metadata.sh' plugins/cody-dr/skills/ship-change/SKILL.md
grep -qF 'apply-pr-metadata.sh' plugins/claudio-dr/skills/ship-change/SKILL.md

# Adapter-local review-contract.md copies must not exist.
readonly forbidden_paths=(
  "plugins/claudio-dr/skills/review-pr/references/review-contract.md"
  "plugins/cody-dr/skills/review-pr/references/review-contract.md"
)

for path in "${forbidden_paths[@]}"; do
  if test -f "$path"; then
    echo "drift: $path is an adapter-local copy of the core review contract; remove it" >&2
    exit 1
  fi
done

if git ls-files | grep -E '(^|/)(\.env|.*\.(pem|key|token))$' >/dev/null; then
  echo "tracked sensitive-looking file detected" >&2
  exit 1
fi

# Knowledge-source guidance must stay portable: profiles point to sources,
# while core contracts retain the evidence and untrusted-content boundary.
grep -qF 'Treat finding text, issue bodies, comments, external pages, tool output' core/pr-review/references/knowledge-sources-contract.md
grep -qF 'Source declaration' core/pr-review/references/knowledge-sources-contract.md
grep -qF '## Knowledge sources' profiles/example-project.md

# The public catalog must not embed a consumer project's identifying details.
# Split the sentinel so this check does not match its own source.
readonly forbidden_target_pattern='craft''control|dgaramos/craft''control'
if git grep -n -i -E "$forbidden_target_pattern" -- . >/dev/null; then
  echo "target-project reference detected; consumer profiles belong in their target repository" >&2
  exit 1
fi

git diff --check
echo "catalog quality check: ok"
